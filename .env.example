# ═══════════════════════════════════════════════════════════════════════════
# AI Provider Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Choose your AI provider:
# "ollama"    = FREE, local, no billing (recommended for testing)
# "anthropic" = Paid cloud API, requires paid account
AI_PROVIDER=ollama

# ═══════════════════════════════════════════════════════════════════════════
# Ollama Configuration (FREE Local AI)
# ═══════════════════════════════════════════════════════════════════════════
# Ollama endpoint where the model runs locally
# Default: http://localhost:11434
# Make sure to run: ollama serve
OLLAMA_ENDPOINT=http://localhost:11434

# ═══════════════════════════════════════════════════════════════════════════
# Anthropic Configuration (Paid Cloud API)
# ═══════════════════════════════════════════════════════════════════════════
# Only needed if you switch AI_PROVIDER to "anthropic"
# Get your API key from: https://console.anthropic.com/account/keys
# Requires paid account (no free tier permanently)
VITE_ANTHROPIC_API_KEY=your_api_key_here
